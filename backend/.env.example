# WAD AI Office — Connected Mode server settings
# Copy to .env on the SERVER only (or set these in your host's environment panel).
# Placeholders only. Never commit a real .env, and never put secrets in VITE_* / WAD_PUBLIC_*
# variables — anything with those prefixes is bundled into the browser code.

NODE_ENV=production
PORT=8787
# 127.0.0.1 when a reverse proxy (Hostinger/Nginx) sits in front; 0.0.0.0 to listen publicly.
HOST=127.0.0.1

# Behind a proxy (Render, or Vercel forwarding /api): set true so sign-in throttling sees each
# visitor's own address instead of the proxy's. Leave false when running on this PC.
TRUST_PROXY=false

# Optional: folder of a built front end for this server to serve too (e.g. ../frontend/dist).
# Leave empty when the front end is hosted separately (Vercel); the server then answers /api only.
STATIC_DIR=

# ---- Application sign-in (required before Connected Mode is reachable publicly) ----
# Public address of the office, used for cross-site request checks.
APP_ORIGIN=https://office.example.com
# Comma-separated username:role:hash. Create each hash with `npm run hash-password <username> <role>`.
# Roles: admin, manager (finance + orders), finance (finance only), operations (orders only).
APP_USERS=
APP_SESSION_HOURS=8
APP_COOKIE_SECURE=true

# ---- Approved API hosts ----
# Requests are only ever sent to these hostnames. Base URLs on any other host are rejected.
API_ALLOWED_HOSTS=wadfurniture-management.wadcatalog.com,wad-order-management.wadcatalog.com

# ---- WAD Furniture Management (finance, income, expenses, budgets) ----
# Bearer token: the value of FURNITURE_CEO_API_TOKEN / api/ceo/token.php on that server.
FINANCE_API_TOKEN=
FINANCE_API_BASE_URL=https://wadfurniture-management.wadcatalog.com/api/

# ---- WAD Order Management (orders, production progress, deadlines) ----
# Bearer token: the value of CEO_API_TOKEN / api/ceo/config.php on that server.
ORDERS_API_TOKEN=
ORDERS_API_BASE_URL=https://wad-order-management.wadcatalog.com/api/

# ---- AI tasks (Assign Task in Connected Mode) ----
# Google Gemini API key from https://aistudio.google.com/apikey — server only, never VITE_/WAD_PUBLIC_.
# Leave empty to switch AI tasks off. On Google's FREE tier, prompts and the data sent with them
# may be used by Google to improve its products; use a paid (billing-enabled) key for business data.
GEMINI_API_KEY=
# Model name. Flash-Lite has the most generous free quota. List what your key can use:
#   npm run gemini-models
GEMINI_MODEL=gemini-flash-lite-latest
AI_TIMEOUT_MS=60000
# Most data lookups per task (each is one extra AI request against your quota).
AI_MAX_TOOL_ROUNDS=3
# Plain-text business notes the AI reads on every task (prices, policies, examples).
KNOWLEDGE_DIR=knowledge

# ---- Reliability ----
API_TIMEOUT_MS=15000
API_MAX_RETRIES=2
# Safety cap on pages fetched per request; larger results fail instead of being truncated.
API_MAX_PAGES=50
MAX_CONCURRENT_JOBS=2
REPORT_MAX_RANGE_DAYS=366

# ---- Task log (JSON lines: ids, report type, user, status, timings, error codes) ----
TASK_LOG_FILE=logs/tasks.jsonl

# Development only: allow http://localhost test APIs. Ignored when NODE_ENV=production.
ALLOW_INSECURE_LOCAL_APIS=false
